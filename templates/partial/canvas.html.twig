<div
    class="presentation-editor"
    data-bg="{{ presentation.backgroundColor|default('#1a1a1a') }}"
    data-image-url="{{ presentation.imageFilename is defined and presentation.imageFilename ? asset('uploads/' ~ presentation.imageFilename) : '' }}"
    data-format="{{ presentation.format|default('16:9') }}"
>
    {{ form_start(form, { attr: { enctype: 'multipart/form-data' } }) }}
    {{ form_errors(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.backgroundColor, {
        attr: { class: 'presentation-editor-color-input' }
    }) }}
    {{ form_row(form.format) }}
    {{ form_row(form.imageFile, {
        attr: { class: 'presentation-editor-image-input' }
    }) }}

    <div class="presentation-preview">
        <canvas
            class="presentation-editor-canvas"
            width="800"
            height="450"
        ></canvas>
    </div>
    <button type="submit">{{ submit_label|default('Enregistrer') }}</button>
    {{ form_end(form) }}
</div>
