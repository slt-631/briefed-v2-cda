<div
    class="editor"
    data-controller="presentation-editor"
    data-presentation-editor-bg-value="{{ presentation.backgroundColor|default('#1a1a1a') }}"
    data-presentation-editor-image-url-value="{{ presentation.imageFilename is defined and presentation.imageFilename ? asset('uploads/' ~ presentation.imageFilename) : '' }}"
    data-presentation-editor-format-value="{{ presentation.format|default('16:9') }}"
>
    {{ form_start(form, { attr: { enctype: 'multipart/form-data', class: 'editor-form' } }) }}
    {{ form_errors(form) }}

    <div class="sidebar">
        <div>
            <h5>TITRE DE LA PRÉSENATATION</h5>
            {{ form_row(form.title) }}
        </div>

        <div>
            <h5>FORMAT</h5>
            {{ form_row(form.format, {
                attr: { 'data-presentation-editor-target': 'formatInput' }
            }) }}
        </div>

        <div>
    <h5>COULEUR DE FOND</h5>
    <label class="color-field">
        {{ form_widget(form.backgroundColor, {
            attr: { 'data-presentation-editor-target': 'colorInput' }
        }) }}
        <span class="color-field-hex" data-presentation-editor-target="colorHexLabel"> {{ presentation.backgroundColor }}</span>
        <i class="fa-solid fa-eye-dropper"></i>
    </label>
</div>

        <div>
            <h5>IMAGE</h5>
            <label class="image-field{% if presentation.imageFilename is defined and presentation.imageFilename %} is-filled{% endif %}">
                {{ form_widget(form.imageFile, {
                    attr: { 'data-presentation-editor-target': 'imageInput' }
                }) }}
                <i class="fa-solid fa-plus"></i>
                <p>Glisser une image</p>
                <img
                    class="image-field-preview"
                    data-presentation-editor-target="imagePreview"
                    alt="Aperçu de l'image"
                    {% if presentation.imageFilename is defined and presentation.imageFilename %}
                        src="{{ asset('uploads/' ~ presentation.imageFilename) }}"
                    {% endif %}
                >
            </label>
        </div>

        <div>
            <h5>POSITION ET ÉCHELLE</h5>
            <button
                class="btn btn-primary"
                type="button"
                data-presentation-editor-target="centerButton"
            >
                Centrer
            </button>
            <div class="range-field">
                {{ form_label(form.posX) }}
                {{ form_widget(form.posX, {
                    attr: { 'data-presentation-editor-target': 'posXInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="-800"
                    max="800"
                    step="1"
                    data-presentation-editor-target="posXNumberInput"
                >
            </div>
            <div class="range-field">
                {{ form_label(form.posY) }}
                {{ form_widget(form.posY, {
                    attr: { 'data-presentation-editor-target': 'posYInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="-450"
                    max="450"
                    step="1"
                    data-presentation-editor-target="posYNumberInput"
                >
            </div>
            <div class="range-field">
                {{ form_label(form.scale) }}
                {{ form_widget(form.scale, {
                    attr: { 'data-presentation-editor-target': 'scaleInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="0.1"
                    max="5"
                    step="0.1"
                    data-presentation-editor-target="scaleNumberInput"
                >
            </div>
        </div>

        <div>
            <h5>STYLE ET EFFET</h5>
            <div class="range-field">
                {{ form_label(form.border) }}
                {{ form_widget(form.border, {
                    attr: { 'data-presentation-editor-target': 'borderInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="0"
                    max="100"
                    step="1"
                    data-presentation-editor-target="borderNumberInput"
                >
            </div>
            {{ form_row(form.borderColor, {
                attr: { 'data-presentation-editor-target': 'borderColorInput' }
            }) }}
            <div class="range-field">
                {{ form_label(form.borderOpacity) }}
                {{ form_widget(form.borderOpacity, {
                    attr: { 'data-presentation-editor-target': 'borderOpacityInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="0"
                    max="100"
                    step="1"
                    data-presentation-editor-target="borderOpacityNumberInput"
                >
            </div>
            <div class="range-field">
                {{ form_label(form.radius) }}
                {{ form_widget(form.radius, {
                    attr: { 'data-presentation-editor-target': 'radiusInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="0"
                    max="100"
                    step="1"
                    data-presentation-editor-target="radiusNumberInput"
                >
            </div>
        </div>

        <div>
            <h5>OMBRE</h5>
            {{ form_row(form.shadowType, {
                attr : { class: 'choice-card' }
            }) }}
            <div class="range-field">
                {{ form_label(form.shadowOpacity) }}
                {{ form_widget(form.shadowOpacity, {
                    attr: { 'data-presentation-editor-target': 'shadowOpacityInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="0"
                    max="100"
                    step="1"
                    data-presentation-editor-target="shadowOpacityNumberInput"
                >
            </div>
            <div class="range-field">
                {{ form_label(form.shadowAngle) }}
                {{ form_widget(form.shadowAngle, {
                    attr: { 'data-presentation-editor-target': 'shadowAngleInput' }
                }) }}
                <input
                    class="range-field-value"
                    type="number"
                    min="0"
                    max="360"
                    step="1"
                    data-presentation-editor-target="shadowAngleNumberInput"
                >
            </div>
        </div>
    </div>

    <div class="canvas-image">
        <div class="canva">
            <canvas
                data-presentation-editor-target="canvas"
                width="800"
                height="450"
            ></canvas>
        </div>

        <div class="button-section">
            <button type="submit" class="btn btn-primary">{{ submit_label|default('Enregistrer') }}</button>
            <button
                type="button"
                class="btn btn-secondary"
                data-presentation-editor-target="exportButton"
            >
                Exporter PNG
            </button>
        </div>
    </div>

    {{ form_end(form) }}
</div>
