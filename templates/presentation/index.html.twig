{% extends 'base.html.twig' %}

{% block title %}Mes présentations{% endblock %}



{% block body %}

{% include 'partial/header.html.twig' %}


   <div class="dashboard">
        <div class="dashboard-toolbar">
            <h1>Mes présentations</h1>
            <a href="{{ path('app_presentation_new') }}" class="btn btn-primary">
                Nouvelle présentation
            </a>
        </div>
        <div class="presentation-grid">
            {% for presentation in presentations %}
                <div class="presentation-card">
                    <div
                        class="presentation-card-thumbnail"
                    >
                        {% if presentation.imageFilename %}
                            <img
                                src="{{ asset('uploads/' ~ presentation.imageFilename) }}"
                                alt="{{ presentation.title }}"
                            >
                        {% endif %}
                    </div>
                    <div class="presentation-card-meta">
                        <h2>{{ presentation.title }}</h2>
                        <time>Modifié le {{ presentation.updatedAt|date('d/m/Y') }}</time>
                    </div>
                    <div class="action-btn">
                        <a
                            href="{{ path('app_presentation_edit', { id: presentation.id }) }}"
                            class="btn btn-secondary"
                        >
                            Modifier
                        </a>
                        <form
                            method="post"
                            action="{{ path('app_presentation_delete', { id: presentation.id }) }}"
                            onsubmit="return confirm('Voulez-vous vraiment supprimer cette présentation ?');"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ presentation.id) }}">
                            <button type="submit" class="btn btn-delete">Supprimer</button>
                        </form>
                    </div>
                </div>
            {% else %}
                <p>Aucune présentation pour le moment.</p>
            {% endfor %}
        </div>
    </div>
{% endblock %}
