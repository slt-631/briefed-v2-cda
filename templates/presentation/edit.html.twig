{% extends 'base.html.twig' %}

{% block title %}Modifier{% endblock %}

{% block body %}
    <h1>Modifier « {{ presentation.title }} »</h1>

    {% if presentation.imageFilename %}
        <p>Image actuelle : {{ presentation.imageFilename }}</p>
    {% endif %}

    {{ form_start(form, { attr: { enctype: 'multipart/form-data' } }) }}
        {{ form_errors(form) }}

        {{ form_row(form.title) }}
        {{ form_row(form.backgroundColor) }}
        {{ form_row(form.format) }}
        {{ form_row(form.imageFile) }}

        <button type="submit">Enregistrer</button>
    {{ form_end(form) }}

    <a href="{{ path('app_presentation_index') }}">Retour</a>
{% endblock %}
